{
  "name": "stallion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @stallion/web",
    "fix": "biome check --write . && cargo fmt --all",
    "lint": "biome check .",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "build": "npm run build --workspaces --if-present",
    "build:worker": "sh npm-scripts/build-worker.sh",
    "smoke": "node npm-scripts/smoke.mjs",
    "wait:live": "node npm-scripts/wait-live.mjs",
    "demo:duo": "node npm-scripts/duo-demo.mjs",
    "serve:sync": "VITE_SYNC_URL=${VITE_SYNC_URL:-ws://100.104.44.51:8787} npm run build -w @stallion/web && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy:dry": "wrangler deploy --dry-run --outdir ~/development/.tmp/stallion-dry",
    "deploy": "node npm-scripts/deploy.mjs",
    "infra:plan": "node npm-scripts/infra.mjs plan",
    "infra:apply": "node npm-scripts/infra.mjs apply",
    "access:env": "node npm-scripts/access-env.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
