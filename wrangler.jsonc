{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stallion",
  "main": "crates/server/build/index.js",
  "compatibility_date": "2026-09-25",
  "build": {
    "command": "npm run build:worker"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" },
      { "name": "USER_INDEX", "class_name": "UserIndex" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] },
    { "tag": "v2", "new_sqlite_classes": ["UserIndex"] }
  ]
}
